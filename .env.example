# Postgres in production, e.g.
#   postgresql://mero:mero@postgres.postgres.svc.cluster.local:5432/mero
# The async driver (asyncpg) is chosen automatically. Leave blank to use a
# local SQLite file (./mero.db), which is what a local run needs.
DATABASE_URL=

# Signs login tokens. Generate with: openssl rand -hex 32
# Unset means a random key per process start, so everyone is logged out on
# every restart. Fine locally, not in a deployment.
SECRET_KEY=

# Comma-separated origins allowed to call the API. Auth is a bearer token, not
# a cookie, so "*" is safe; narrow it if you like.
CORS_ORIGINS=*

LOG_LEVEL=INFO

# Migrations run on startup (alembic upgrade head). Set false to build the
# schema with create_all() instead, which records no revision.
USE_ALEMBIC_MIGRATIONS=true

# Port for `python main.py` (local runs). The container always listens on 8000.
PORT=1184
